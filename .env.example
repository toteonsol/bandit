# Server-only secrets. Never commit real values.
# SERV Reasoning key from console.openserv.ai (API Keys)
SERV_API_KEY=
# Optional: any model ID from docs.openserv.ai/serv-reasoning/models (default gpt-5.4-mini)
SERV_MODEL=
# Passphrase that unlocks Owner mode (rules, Run now) in the app
OWNER_KEY=
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Private key of a brand-new wallet used only by the agent, funded with a little ETH on Robinhood Chain
AGENT_PRIVATE_KEY=
# Upstash Redis REST credentials (Vercel's Upstash integration sets these)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set to true to send real transactions; anything else is dry run
AGENT_LIVE=
# Set to true to stop the agent entirely
AGENT_PAUSED=
# Optional: Vercel sends it as a Bearer token on cron runs
CRON_SECRET=
# Public URL used for the Telegram webhook
PUBLIC_URL=https://bandit-bands.vercel.app
